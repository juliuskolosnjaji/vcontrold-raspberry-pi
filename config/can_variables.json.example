{
  "_hinweis": "Custom CAN-Variablen: komplett unabhängig von vito.xml/vcontrold. Home Assistant kann sie direkt lesen UND schreiben, der Wert geht per CAN direkt an die UVR -- die Vitotronic ist hier nicht beteiligt. Den Variablennamen zusätzlich als Kanal in einem Write-Slot (Senden) und optional einem Read-Slot (Empfangen) in config/can_mapping.json eintragen, damit tatsächlich etwas über CAN läuft.",

  "uvr_sollwert_kollektor": {
    "discovery": {"component": "number", "unit": "°C", "min": 0, "max": 100, "step": 0.5}
  },
  "uvr_pumpe_override": {
    "discovery": {"component": "select", "options": ["AUTO", "AN", "AUS"]}
  }
}
