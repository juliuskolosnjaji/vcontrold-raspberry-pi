# Zugangsdaten für den MQTT-Broker (läuft auf Home Assistant, z.B. Mosquitto-Add-on)
# Falls "homeassistant.local" bei dir falsch auflöst (mDNS-Probleme, "Connection refused"
# trotz "succeeded" bei nc auf die echte IP): stattdessen die feste IP deines
# Home-Assistant-Rechners eintragen (per "getent hosts homeassistant.local" gegenprüfen).
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=raspi-vcontrold

# Topic-Präfixe
MQTT_TOPIC_HEIZUNG=heizung
MQTT_TOPIC_UVR=uvr
MQTT_TOPIC_CMD_HEIZUNG=heizung/cmd
# Für custom CAN-Variablen (config/can_variables.json), die HA direkt an die UVR schicken
# kann, ohne über vcontrold zu gehen -- siehe README Abschnitt 3.2.
MQTT_TOPIC_CMD_UVR=uvr/cmd

# Home-Assistant-MQTT-Discovery: orchestrator.py legt beim Start automatisch Sensoren/
# Number/Select-Entities in Home Assistant an, statt dass du homeassistant/
# configuration_snippet.yaml von Hand einträgst. MQTT_DISCOVERY_PREFIX muss mit dem
# "Discovery-Präfix" der MQTT-Integration in Home Assistant übereinstimmen (Standard
# dort ist ebenfalls "homeassistant").
MQTT_DISCOVERY_ENABLED=true
MQTT_DISCOVERY_PREFIX=homeassistant
