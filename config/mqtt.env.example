# Zugangsdaten für den MQTT-Broker (läuft auf Home Assistant, z.B. Mosquitto-Add-on)
# Falls "homeassistant.local" bei dir falsch auflöst (mDNS-Probleme, "Connection refused"
# trotz "succeeded" bei nc auf die echte IP): stattdessen die feste IP deines
# Home-Assistant-Rechners eintragen (per "getent hosts homeassistant.local" gegenprüfen).
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=raspi-vcontrold

# Topic-Präfixe
MQTT_TOPIC_HEIZUNG=heizung
MQTT_TOPIC_UVR=uvr
MQTT_TOPIC_CMD_HEIZUNG=heizung/cmd
