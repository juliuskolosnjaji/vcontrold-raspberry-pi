[Unit]
Description=MQTT -> vcontrold command listener
After=network.target vcontrold.service
Requires=vcontrold.service

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__/scripts
ExecStart=__INSTALL_DIR__/venv/bin/python3 __INSTALL_DIR__/scripts/mqtt_command_listener.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
