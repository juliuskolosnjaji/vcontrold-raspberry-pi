[Unit]
Description=Vcontrold-Orchestrator (Read-Zyklen, Set-Befehle, Verifikation)
After=network.target vcontrold.service
Requires=vcontrold.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=__INSTALL_DIR__/scripts
ExecStart=__INSTALL_DIR__/venv/bin/python3 __INSTALL_DIR__/scripts/orchestrator.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
