# Zugangsdaten für die Web-UI (Basic Auth)
UI_USERNAME=admin
UI_PASSWORD=change-me

# Pfad zur Haupt-vcontrold-Config (wird beim Config-Import überschrieben/gebackupt)
VCONTROLD_MAIN_XML_PATH=/etc/vcontrold.xml

# Pfad zur Geräte-/Protokoll-XML, aus der die Console ihre Getter/Setter-Liste liest
# (z.B. /usr/local/etc/vcontrold/xml/300/vito.xml -- an dein Gerät anpassen)
DEVICE_XML_PATH=

VCLIENT_HOST=localhost
VCLIENT_PORT=3002

CAN_INTERFACE=can0

# systemd-Dienste, die auf der Diagnose-Seite angezeigt werden
MONITORED_SERVICES=vcontrold,can-to-mqtt,mqtt-to-can,mqtt-command-listener,can0-up
