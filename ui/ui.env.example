# Zugangsdaten für das Login der Web-UI
UI_USERNAME=admin
UI_PASSWORD=change-me

# Pfad zur Haupt-vcontrold-Config (wird beim Config-Import überschrieben/gebackupt)
VCONTROLD_MAIN_XML_PATH=/etc/vcontrold/vcontrold.xml

# Pfad zur Geräte-/Protokoll-XML, aus der die Console ihre Getter/Setter-Liste liest
# (Standard nach Installation: /etc/vcontrold/vito.xml)
DEVICE_XML_PATH=/etc/vcontrold/vito.xml

VCLIENT_HOST=localhost
VCLIENT_PORT=3002

CAN_INTERFACE=can1

# systemd-Dienste, die auf der Diagnose-Seite angezeigt werden
MONITORED_SERVICES=vcontrold,orchestrator,can-node,can1-up
